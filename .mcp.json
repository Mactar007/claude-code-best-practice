{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.70",
        "--browser=chromium",
        "--executable-path=/opt/pw-browsers/chromium",
        "--headless",
        "--proxy-server=http://127.0.0.1:44727"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@2.1.8"
      ]
    },
    "deepwiki": {
      "command": "npx",
      "args": [
        "-y",
        "deepwiki-mcp@0.0.6"
      ]
    }
  }
}
