PORT=3000

# From https://manage.wix.com/account/api-keys — scope it to "Read products
# in v3 catalog" (SCOPE.STORES.PRODUCT_READ) on this site only.
WIX_API_KEY=

# Site ID of the Wix store to query (appears after /dashboard/ in the URL
# when you're on that site's dashboard).
WIX_SITE_ID=

# Shared secret your Hermes/OpenClaw HTTP node must send as the
# x-webhook-secret header. Leave empty to disable the check (not recommended
# once the webhook has a public URL).
WEBHOOK_SHARED_SECRET=
